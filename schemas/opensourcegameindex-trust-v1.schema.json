{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foss-gameindex.github.io/opensourcegameindex/schema/v1/trusted-publishers.schema.json",
  "title": "OpenSourceGameIndex trusted publisher registry",
  "type": "object",
  "required": ["schema_version", "sequence", "issued_at_utc", "keys", "signature"],
  "properties": {
    "schema_version": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "issued_at_utc": { "type": "string", "minLength": 20, "maxLength": 40 },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/publisherKey" }
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "additionalProperties": false,
  "$defs": {
    "signature": {
      "type": "object",
      "required": ["key_id", "value"],
      "properties": {
        "key_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
        "value": {
          "type": "string",
          "minLength": 344,
          "maxLength": 1024,
          "contentEncoding": "base64",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      },
      "additionalProperties": false
    },
    "publisherKey": {
      "type": "object",
      "required": ["key_id", "algorithm", "modulus_hex", "exponent", "usages", "status"],
      "properties": {
        "key_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
        "algorithm": { "const": "rsa-pkcs1v15-sha256" },
        "modulus_hex": {
          "type": "string",
          "minLength": 512,
          "maxLength": 1024,
          "pattern": "^(?:[A-Fa-f0-9]{2}){256,512}$"
        },
        "exponent": { "const": 65537 },
        "usages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "const": "game-index" }
        },
        "status": { "enum": ["active", "revoked"] },
        "revoked_at_sequence": { "type": "integer", "minimum": 1 },
        "revoked_at_utc": { "type": "string", "minLength": 20, "maxLength": 40 },
        "reason": { "type": "string", "maxLength": 512 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "revoked" } } },
          "then": { "required": ["revoked_at_sequence", "revoked_at_utc"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["revoked_at_sequence"] },
                { "required": ["revoked_at_utc"] },
                { "required": ["reason"] }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
